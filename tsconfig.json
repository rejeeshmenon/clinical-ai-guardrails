{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "demo/**/*.ts",
    "superhuman/lib/**/*.ts",
    "superhuman/tests/**/*.ts",
    "superhuman/scripts/**/*.ts",
    "priya/guardrails/**/*.ts",
    "priya/state/**/*.ts",
    "priya/summary/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "superhuman/lib/ai/claude.ts",
    "superhuman/lib/lab-parsing/claude.ts",
    "superhuman/lib/lab-parsing/prepare-image.ts",
    "superhuman/lib/jobs/**",
    "priya/llm/**",
    "priya/observability/**"
  ]
}
